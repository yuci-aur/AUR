# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Firebase service account keys — grant full project access, never commit
*serviceaccount*.json
*service-account*.json
*firebase-adminsdk*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# local runtime logs
/.codex-runtime/
firebase-debug.log*
firestore-debug.log*
frontend-dev.*.log
lint_errors.txt

# python tooling
/.pytest_cache/

# pnpm is the only package manager here. A stray npm lockfile makes the build
# host's package-manager detection ambiguous, which breaks the file tracing that
# copies server-external packages (firebase-admin) into the deployed function.
package-lock.json
yarn.lock
